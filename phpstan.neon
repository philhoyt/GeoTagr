includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 5
    paths:
        - geotagr.php
        - uninstall.php
        - includes
    scanDirectories:
        - lib/plugin-update-checker
    bootstrapFiles:
        - tests/phpstan-bootstrap.php
    excludePaths:
        - vendor (?)
        - node_modules (?)
        - build (?)
        - tests
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # build/*.asset.php are generated by the JS build and absent in static analysis.
        -
            identifier: require.fileNotFound
            paths:
                - includes/*
